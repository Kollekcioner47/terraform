# Настройки провайдера Яндекс Облака.
#
# Провайдеру нужно знать, от чьего имени работать (ключ сервисного аккаунта)
# и где создавать ресурсы (облако и каталог).
#
# Идентификаторы берутся из переменных, а их значения — из файла
# terraform.tfvars, который в репозиторий не попадает: у каждого студента
# свои облако и каталог.

provider "yandex" {
  cloud_id  = var.cloud_id
  folder_id = var.folder_id

  # Зона по умолчанию: ресурсы без явной зоны создаются здесь.
  zone = var.zone

  # Авторизованный ключ сервисного аккаунта. Путь лежит вне каталога
  # проекта: ключ не должен попасть ни в git, ни в архив с материалами.
  service_account_key_file = var.sa_key_file
}

# Альтернатива ключу — временный IAM-токен:
#
#   export YC_TOKEN=$(yc iam create-token)
#
# Тогда блок provider можно оставить пустым, а cloud_id и folder_id
# задать переменными окружения YC_CLOUD_ID и YC_FOLDER_ID. Разница
# в том, что токен живёт не больше 12 часов, а ключ — бессрочно;
# поэтому ключ удобнее для занятий, а токен безопаснее в конвейере.
