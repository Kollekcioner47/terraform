# Пример файла со значениями переменных.
#
# Скопируйте его в terraform.tfvars и подставьте свои значения:
#
#   cp terraform.tfvars.example terraform.tfvars
#
# Файл terraform.tfvars в репозиторий не попадает: он перечислен
# в .gitignore. Здесь оказываются идентификаторы вашего каталога
# и путь к ключу сервисного аккаунта.
#
# Где взять идентификаторы:
#   yc config get cloud-id
#   yc config get folder-id
#
# Путь к ключу указывается в формате с прямыми слэшами даже в Windows:
# Terraform понимает "C:/Users/name/key.json", а "C:\Users\name\key.json"
# во многих случаях ломается на обратных слэшах.

cloud_id     = "b1gXXXXXXXXXXXXXXX"
folder_id    = "b1gYYYYYYYYYYYYYYY"
zone         = "ru-central1-d"
sa_key_file  = "C:/Users/user/key.json"
project_name = "tf-course"
image_family = "ubuntu-2604-lts"

vm_cores = 2
vm_memory = 2

# Публичный SSH-ключ. Создать пару ключей:
#   ssh-keygen -t ed25519 -C "tf-course"
ssh_public_key = "~/.ssh/id_ed25519.pub"
