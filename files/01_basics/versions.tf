# Версии, от которых зависит конфигурация.
#
# required_version ограничивает версии самого Terraform, required_providers —
# версии провайдеров. Без этих ограничений конфигурация «работает у меня»
# и перестаёт работать у коллеги или в конвейере через полгода.

terraform {
  # 1.6.3 — минимальная версия, с которой корректно работает хранилище
  # состояния в Object Storage (разбирается в практике 2). Для нативной
  # блокировки состояния нужен Terraform 1.10 и новее.
  required_version = ">= 1.6.3"

  required_providers {
    yandex = {
      source = "yandex-cloud/yandex"
      # Знак ~> разрешает обновления внутри минорной версии:
      # 0.229.1 установится, 0.230.0 — нет. Так обновление не ломает
      # конфигурацию неожиданно, но и не оставляет её без исправлений.
      version = "~> 0.229.0"
    }
  }
}
