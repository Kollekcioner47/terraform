# Виртуальная машина.
#
# Разбираем три вещи, которые чаще всего вызывают вопросы:
#   1) откуда берётся образ (источник данных, а не жёсткий идентификатор);
#   2) как передаётся SSH-ключ (через метаданные, а не через диск);
#   3) почему изменение параметров пересоздаёт машину и как это смягчить.

# Источник данных: Terraform спрашивает у облака, какой образ сейчас
# считается последним в семействе. Идентификатор образа меняется при
# каждом обновлении образа Яндексом, семейство — нет.
#
# Если вместо источника данных вписать идентификатор руками, конфигурация
# продолжит работать, но рано или поздно окажется, что она разворачивает
# операционную систему, снятую с поддержки.
data "yandex_compute_image" "os" {
  family = var.image_family
}

resource "yandex_compute_instance" "app" {
  name        = "${var.project_name}-vm"
  description = "Учебная виртуальная машина курса Terraform"

  zone        = var.zone
  platform_id = "standard-v3"

  # Разрешить остановку машины, если изменение параметров невозможно
  # на ходу. Без этого Terraform попытается изменить работающую машину
  # и получит отказ облака. Машина при этом будет остановлена — на время
  # обновления сервис недоступен, и это надо помнить в рабочей среде.
  allow_stopping_for_update = true

  resources {
    cores  = var.vm_cores
    memory = var.vm_memory

    # Гарантированная доля ядра в процентах: 20 % дешевле 100 %,
    # но производительность ниже и менее предсказуема. Для занятий
    # этого достаточно, для рабочей нагрузки — нет.
    core_fraction = 20
  }

  # Прерываемая машина: облако может остановить её в любой момент,
  # зато стоит она заметно дешевле. Для учебных прогонов это то, что нужно.
  # Внимание: данные на прерываемой машине не гарантируются.
  scheduling_policy {
    preemptible = true
  }

  boot_disk {
    initialize_params {
      image_id = data.yandex_compute_image.os.id
      type     = "network-hdd"
      size     = 10
    }
  }

  network_interface {
    subnet_id = yandex_vpc_subnet.course.id

    # Публичный адрес. Без него машина доступна только изнутри облака.
    # Адрес выдаётся динамически: при пересоздании машины он изменится.
    nat = true
  }

  metadata = {
    # Формат метаданных ssh-keys — "пользователь:ключ". Имя пользователя
    # обязательно: без него облако не знает, в каком домашнем каталоге
    # прописать ключ, и вход по ключу не работает.
    ssh-keys = "ubuntu:${file(var.ssh_public_key)}"
  }

  labels = {
    course = "terraform"
    lesson = "1"
  }
}
