# Хранилище состояния в Object Storage.
#
# Этот файл надо переименовать из backend.tf.example в backend.tf и
# подставить имя своего бакета. Пока он называется .example, Terraform
# его не читает и работает с локальным файлом состояния.
#
# ВАЖНО про блок backend: его аргументы нельзя задавать переменными
# Terraform. Это ограничение самого Terraform: блок backend читается
# до того, как становятся известны значения переменных. Поэтому имя
# бакета здесь пишется текстом, а ключи доступа передаются отдельно —
# переменными окружения или файлом с ключом -backend-config.

terraform {
  backend "s3" {
    # Object Storage совместим с S3, поэтому используется бэкенд s3.
    endpoints = {
      s3 = "https://storage.yandexcloud.net"
    }

    bucket = "tf-course-state-ВАШЕ-ИМЯ"
    region = "ru-central1"
    key    = "course/terraform.tfstate"

    # Нативная блокировка состояния (Terraform 1.10 и новее).
    # Terraform создаёт рядом с состоянием объект-замок
    # <ключ состояния>.tflock через условную запись. Пока один человек
    # применяет изменения, второй получит понятную ошибку, а не испортит
    # состояние.
    use_lockfile = true

    # Object Storage не во всём совпадает с S3, поэтому проверки,
    # которые Terraform выполняет для AWS, приходится отключить.
    skip_region_validation      = true
    skip_credentials_validation = true
    skip_requesting_account_id  = true
    skip_s3_checksum            = true
  }
}

# ЧЕГО ЗДЕСЬ СОЗНАТЕЛЬНО НЕТ
#
# Параметра dynamodb_table. Документация Яндекс Облака до сих пор
# описывает блокировку состояния через базу данных YDB и таблицу LockID,
# и там же предупреждает: начиная с Terraform 1.11 этот механизм
# объявлен устаревшим и будет удалён. Object Storage поддерживает
# условные записи (заголовок If-None-Match), поэтому достаточно
# use_lockfile. Схема с YDB в курсе не используется.
