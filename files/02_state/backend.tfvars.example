# Ключи доступа к хранилищу состояния.
#
# ЭТОТ ФАЙЛ НЕ КОММИТИТСЯ. Он перечислен в .gitignore вместе с другими
# файлами, содержащими секреты.
#
# Зачем он нужен: аргументы блока backend нельзя задавать переменными
# Terraform, поэтому ключи передаются в момент инициализации:
#
#   terraform init -backend-config=backend.tfvars
#
# Как получить ключи:
#
#   1. Создать статический ключ доступа для сервисного аккаунта:
#
#        yc iam access-key create \
#          --service-account-id <sa_id> \
#          --description "доступ к бакету состояния"
#
#   2. В ответе будет два значения. ВАЖНО: идентификатор ключа лежит
#      во вложенном объекте:
#
#        {
#          "access_key": {
#            "id": "ajetie9irg2oqtm5o0vo",
#            "key_id": "YCAJEXXXXXXXXXXXXXXXXX",   <- это в access_key
#            ...
#          },
#          "secret": "..."                            <- это отдельно
#        }
#
#      В access_key нужно значение key_id (оно начинается с YCAJE),
#      а не id. Если подставить весь объект целиком, Object Storage
#      ответит 400 Bad Request вместо понятной ошибки про права.
#
#   3. Сервисному аккаунту нужна роль storage.editor или storage.admin
#      на каталог — иначе он не сможет читать и записывать состояние.

access_key = "YCAJEXXXXXXXXXXXXXXXXXX"
secret_key = "ВАШ_СЕКРЕТНЫЙ_КЛЮЧ"
