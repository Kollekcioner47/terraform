# Пример блока import: взять под управление ресурс, созданный руками.
#
# Ситуация: сеть создали в консоли до того, как появился Terraform.
# Удалять её нельзя, в ней работает чужой сервис. Блок import описывает
# намерение: «этот ресурс в облаке соответствует вот этому ресурсу
# в конфигурации».
#
# Порядок работы:
#
#   1. Узнать идентификатор существующего ресурса:
#        yc vpc network list
#
#   2. Описать ресурс в конфигурации и добавить блок import (ниже).
#
#   3. Посмотреть, что получится, ничего не меняя:
#        terraform plan -generate-config-out=generated.tf
#      Terraform сгенерирует файл generated.tf с описанием существующего
#      ресурса. Его надо прочитать, убрать лишнее и перенести в свой файл.
#
#   4. Применить:
#        terraform apply
#
#   5. Убедиться, что ресурс под управлением:
#        terraform state list
#
#   6. УДАЛИТЬ блок import из конфигурации: он нужен один раз.
#      Оставить его — значит при следующем применении снова пытаться
#      импортировать тот же ресурс.
#
# ВАЖНО: import НЕ меняет ресурс в облаке. Он только вносит его
# в состояние. Если описание в конфигурации отличается от реальности,
# следующий plan покажет изменения — и это нормально, но именно здесь
# чаще всего случайно ломают чужую инфраструктуру. Читайте план.

import {
  to = yandex_vpc_network.imported
  id = "enpXXXXXXXXXXXXXX"
}

resource "yandex_vpc_network" "imported" {
  name = "network-created-by-hand"

  labels = {
    course = "terraform"
    source = "imported"
  }
}
