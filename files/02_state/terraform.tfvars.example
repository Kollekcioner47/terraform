# Пример значений переменных. Скопируйте в terraform.tfvars.

cloud_id       = "b1gXXXXXXXXXXXXXXX"
folder_id      = "b1gYYYYYYYYYYYYYYY"
zone           = "ru-central1-d"
sa_key_file    = "/home/user/.yc/tf-course-key.json"
project_name   = "tf-state"
image_family   = "ubuntu-2604-lts"
ssh_public_key = "~/.ssh/id_ed25519.pub"

# Имя бакета для состояния. Должно совпадать с тем, что указано
# в backend.tf.
state_bucket = "tf-course-state-ВАШЕ-ИМЯ"
