# Значения переменных для окружения PROD.
#
# Передаётся при запуске:
#   terraform apply -var-file=env/prod.tfvars

cloud_id       = "b1gXXXXXXXXXXXXXXX"
folder_id      = "b1gYYYYYYYYYYYYYYY"
zone           = "ru-central1-a"
sa_key_file    = "/home/user/.yc/tf-course-key.json"
ssh_public_key = "~/.ssh/id_ed25519.pub"

storage_access_key = "YCAJEXXXXXXXXXXXXXXXXXX"
storage_secret_key = "СЕКРЕТНАЯ_ЧАСТЬ_КЛЮЧА"

environment  = "prod"
project_name = "tf-final"

# В prod: машина обычная (не прерываемая), ядер и памяти больше,
# защита ресурсов включена.
create_app   = true
app_cores    = 4
app_memory   = 4
preemptible  = false

site_bucket = "tf-final-prod-site-ivan"

protect_resources = true
